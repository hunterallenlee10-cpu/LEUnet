# Copy to .env.local for local development. Never commit real values.
# In production, set these as SENSITIVE environment variables in Vercel so the
# value is write-only and never shows up in logs or the dashboard UI.

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------

# Prefer a RESTRICTED key (rk_...) over a secret key (sk_...). Grant it only:
#   Checkout Sessions: write | Customers: write | Invoices: write
#   Invoice Items: write | Products: write | Prices: write | PaymentIntents: read
# Use separate keys per environment (test / staging / production).
STRIPE_SECRET_KEY=

# From `stripe listen` locally, or the endpoint's signing secret in the
# Dashboard for deployed environments. Treat it like a secret key.
STRIPE_WEBHOOK_SECRET=

# Shared bearer token protecting POST /api/stripe/invoice.
# Generate with: openssl rand -base64 32
STRIPE_ADMIN_TOKEN=

# Absolute origin used to build Checkout return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Support flow
# ---------------------------------------------------------------------------
# Stripe Price backing the "Other amount" option. Required for supporter-entered
# amounts — `custom_unit_amount` exists only on the Prices API, so it cannot be
# built inline. Preset amounts work without it.
#
# Create it with:
#   STRIPE_SECRET_KEY=sk_test_... node scripts/stripe-setup.mjs
STRIPE_PRICE_SUPPORT_CUSTOM=

# ---------------------------------------------------------------------------
# Email (already used by the contact form; reused for payment notifications)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_FROM_EMAIL=noreply@leeenterprisesunlimited.com
CONTACT_TO_EMAIL=ceo@leeenterprisesunlimited.com

# Where the Pelican Power Wash quote form delivers. Optional - leave it unset
# and quote requests follow CONTACT_TO_EMAIL along with everything else.
#
# Set it only once a domain is verified in Resend. Until then Resend refuses
# every recipient except the account's own address, so pointing this at
# llc.pelicanpowerwash@gmail.com makes the quote form fail while the contact
# form, which sends to the account address, keeps working.
PELICAN_TO_EMAIL=

# Where Thread T-Shirts order requests deliver. Optional and unset on purpose -
# Thread requests follow CONTACT_TO_EMAIL along with everything else, which is
# the intended behavior. This exists only so Thread can be split off later
# without touching the route, and it carries the same caveat as
# PELICAN_TO_EMAIL: until a domain is verified in Resend, any recipient other
# than the account's own address is refused and the form silently fails.
THREAD_TO_EMAIL=
