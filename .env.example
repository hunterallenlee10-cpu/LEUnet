# Copy to .env.local for local development. Never commit real values.
# In production, set these as SENSITIVE environment variables in Vercel so the
# value is write-only and never shows up in logs or the dashboard UI.

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------

# Prefer a RESTRICTED key (rk_...) over a secret key (sk_...). Grant it only:
#   Support flow: Checkout Sessions: write | Products: write | Prices: write
#   Invoicing adds: Customers: write | Invoices: write | PaymentIntents: read
# (docs/STRIPE.md §3.1)
# Use separate keys per environment (test / staging / production).
STRIPE_SECRET_KEY=

# From `stripe listen` locally, or the endpoint's signing secret in the
# Dashboard for deployed environments. Treat it like a secret key.
STRIPE_WEBHOOK_SECRET=

# Shared bearer token protecting POST /api/stripe/invoice.
# Generate with: openssl rand -base64 32
STRIPE_ADMIN_TOKEN=

# Absolute origin used to build Checkout return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Support flow
# ---------------------------------------------------------------------------
# Stripe Price backing the "Other amount" option. Required for supporter-entered
# amounts — `custom_unit_amount` exists only on the Prices API, so it cannot be
# built inline. Preset amounts work without it; "Other" does not.
#
# Create it with:
#   STRIPE_SECRET_KEY=sk_test_... node scripts/stripe-setup.mjs
STRIPE_PRICE_SUPPORT_CUSTOM=

# ---------------------------------------------------------------------------
# Email (already used by the contact form; reused for payment notifications)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_FROM_EMAIL=noreply@leeenterprisesunlimited.com
CONTACT_TO_EMAIL=ceo@leeenterprisesunlimited.com

# Where Lee Systems Co. leads deliver. Optional and unset on purpose - both
# Lee Systems forms fall through to CONTACT_TO_EMAIL along with everything
# else, which is the intended behavior. The two are already distinguishable by
# subject line ("Lee Systems Co. — New Automation Audit Request" vs "Lee
# Systems Co. — New Website Request"). LEE_SYSTEMS_TO_EMAIL covers both forms;
# WEBSITE_TO_EMAIL splits website requests out on their own. LMM_TO_EMAIL, the
# pre-rename name, is still read after LEE_SYSTEMS_TO_EMAIL so an environment
# configured before the rename keeps delivering where it did.
# Caveat: until a domain is verified in Resend, any recipient other than the
# account's own address is refused and the form silently fails.
LEE_SYSTEMS_TO_EMAIL=
WEBSITE_TO_EMAIL=

# Where Business Mastery applications deliver. Optional and unset on purpose,
# like the Lee Systems overrides above: applications fall through to
# CONTACT_TO_EMAIL. The same Resend caveat applies.
BM_TO_EMAIL=

# ---------------------------------------------------------------------------
# Redirects to sites that are not this one
# ---------------------------------------------------------------------------
# Thread T-Shirts runs from its own repo and site, and is no longer one of the
# ventures this site lists (docs/THREAD.md). This is that site's origin, no
# trailing slash. Its only consumer is the /thread-t-shirts and /thread/*
# redirect in next.config.mjs, which keeps the URLs that page used to answer on
# from 404ing; no app code reads it. Unset, the redirect falls back to
# https://thread.leeenterprisesunlimited.com and stays temporary (307); set it
# to the Thread site's real origin and it becomes permanent (308).
NEXT_PUBLIC_THREAD_SITE_URL=

# H1 Performance runs from its own repo and domain, and is no longer one of the
# ventures this site lists (docs/H1.md). This is that site's origin, no trailing
# slash. Its only consumer is the /h1-performance and /h1/* redirect in
# next.config.mjs, which keeps the URLs that page used to answer on from
# 404ing; no app code reads it. Unset, the redirect falls back to the Vercel
# default alias for a project named h1-performance and stays temporary (307);
# set it to the real domain and it becomes permanent (308).
NEXT_PUBLIC_H1_SITE_URL=
