# Copy to .env.local for local development. Never commit real values.
# In production, set these as SENSITIVE environment variables in Vercel so the
# value is write-only and never shows up in logs or the dashboard UI.

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------

# Prefer a RESTRICTED key (rk_...) over a secret key (sk_...). Grant it only:
#   Checkout Sessions: write | Customers: write | Invoices: write
#   Invoice Items: write | Products: write | Prices: write | PaymentIntents: read
# Use separate keys per environment (test / staging / production).
STRIPE_SECRET_KEY=

# From `stripe listen` locally, or the endpoint's signing secret in the
# Dashboard for deployed environments. Treat it like a secret key.
STRIPE_WEBHOOK_SECRET=

# Shared bearer token protecting POST /api/stripe/invoice.
# Generate with: openssl rand -base64 32
STRIPE_ADMIN_TOKEN=

# Absolute origin used to build Checkout return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Support flow
# ---------------------------------------------------------------------------
# Stripe Price backing the "Other amount" option. Required for supporter-entered
# amounts — `custom_unit_amount` exists only on the Prices API, so it cannot be
# built inline. Preset amounts work without it.
#
# Create it with:
#   STRIPE_SECRET_KEY=sk_test_... node scripts/stripe-setup.mjs
STRIPE_PRICE_SUPPORT_CUSTOM=

# ---------------------------------------------------------------------------
# Email (already used by the contact form; reused for payment notifications)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_FROM_EMAIL=noreply@leeenterprisesunlimited.com
CONTACT_TO_EMAIL=ceo@leeenterprisesunlimited.com

# Where Thread T-Shirts order requests deliver. Optional and unset on purpose -
# Thread requests follow CONTACT_TO_EMAIL along with everything else, which is
# the intended behavior. This exists only so Thread can be split off later
# without touching the route, and it carries a caveat: until a domain is
# verified in Resend, any recipient other than the account's own address is
# refused and the form silently fails.
THREAD_TO_EMAIL=

# Where Lee Marketing Mastery website requests deliver. Optional and unset on
# purpose - they fall through LMM_TO_EMAIL to CONTACT_TO_EMAIL along with
# everything else, which is the intended behavior. Set it only if website leads
# should be split from automation leads; the two are already distinguishable by
# subject line ("New Website Request" vs "New Automation Consultation Request").
# Same caveat as THREAD_TO_EMAIL: until a domain is verified in Resend, any
# recipient other than the account's own address is refused and the form
# silently fails.
WEBSITE_TO_EMAIL=

# Where Lee Marketing Mastery marketing requests deliver. Optional and unset on
# purpose - same fall-through and same Resend caveat as WEBSITE_TO_EMAIL. The
# three LMM forms are already distinguishable by subject line ("New Marketing
# Request" vs "New Website Request" vs "New Automation Consultation Request").
MARKETING_TO_EMAIL=

# ---------------------------------------------------------------------------
# Redirects to sites that are not this one
# ---------------------------------------------------------------------------
# H1 Performance runs from its own repo and domain, and is no longer one of the
# ventures this site lists (docs/H1.md). This is that site's origin, no trailing
# slash. Its only consumer is the /h1-performance and /h1/* redirect in
# next.config.mjs, which keeps the URLs that page used to answer on from
# 404ing; no app code reads it. Unset, the redirect falls back to the Vercel
# default alias for a project named h1-performance and stays temporary (307);
# set it to the real domain and it becomes permanent (308).
NEXT_PUBLIC_H1_SITE_URL=
